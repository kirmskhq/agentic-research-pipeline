# Any OpenAI-compatible endpoint. Defaults target Yandex AI Studio.
LLM_API_KEY=
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1/
# For Yandex-style gpt://<folder>/<model> ids:
YANDEX_FOLDER_ID=
# ...or set the model id directly (OpenAI, DeepSeek, OpenRouter, local vLLM, ...):
# LLM_MODEL=deepseek-chat

# Loop and gate tuning (defaults shown)
RESEARCH_MAX_CRITIC_ROUNDS=3
RESEARCH_EXTRA_SEARCH_BUDGET=6
RESEARCH_HOLD_BROKEN_URLS=2
RESEARCH_HOLD_UNGROUNDED=3
# RESEARCH_VERDICT_FILE=/tmp/verdict.txt
